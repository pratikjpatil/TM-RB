# Lombok configuration for ReportBuilder
# Instructs Lombok's @RequiredArgsConstructor (and all other constructor-generating
# annotations) to copy @Qualifier onto the generated constructor parameters.
# Without this, Spring's @Qualifier on a final field is invisible to the DI
# container, which resolves beans through the constructor — causing
# UnsatisfiedDependencyException when multiple Executor beans exist.
config.stopBubbling = true
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier